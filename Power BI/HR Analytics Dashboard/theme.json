{
  "name": "Custom Theme",
  "dataColors": [
    "#6b1716",
    "#e76895",
    "#7bc988",
    "#0898af",
    "#1625ed"
  ],
  "foreground": "#111827",
  "background": "#f0e8e8",
  "foregroundNeutralSecondary": "#6b7280",
  "backgroundLight": "#e1d1d0",
  "foregroundNeutralTertiary": "#6b7280",
  "backgroundNeutral": "#f8f3f3",
  "tableAccent": "#6b1716",
  "maximum": "#7bc988",
  "center": "#e76895",
  "minimum": "#6b1716",
  "bad": "#6b1716",
  "neutral": "#e76895",
  "good": "#7bc988",
  "textClasses": {
    "callout": {
      "color": "#111827",
      "fontFace": "'Segoe UI', Tahoma, Geneva, Verdana, sans-serif"
    },
    "title": {
      "color": "#111827",
      "fontFace": "'Segoe UI', Tahoma, Geneva, Verdana, sans-serif"
    },
    "header": {
      "color": "#111827",
      "fontFace": "'Segoe UI', Tahoma, Geneva, Verdana, sans-serif"
    },
    "label": {
      "color": "#111827",
      "fontFace": "'Segoe UI', Tahoma, Geneva, Verdana, sans-serif"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#f8f3f3"
              }
            }
          }
        ],
        "border": [
          {
            "color": {
              "solid": {
                "color": "#f8f3f3"
              }
            },
            "show": true,
            "radius": 8
          }
        ],
        "visualHeader": [
          {
            "background": {
              "solid": {
                "color": "#f8f3f3"
              }
            },
            "border": {
              "solid": {
                "color": "#f8f3f3"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#e1d1d0"
              }
            }
          }
        ],
        "outspacePane": [
          {
            "backgroundColor": {
              "solid": {
                "color": "#ffffff"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "#000000"
              }
            }
          }
        ],
        "background": [
          {
            "color": {
              "solid": {
                "color": "#f0e8e8"
              }
            },
            "transparency": 0
          }
        ],
        "filterCard": [
          {
            "$id": "Applied",
            "backgroundColor": {
              "solid": {
                "color": "#ececec"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "#000000"
              }
            },
            "transparency": 0
          },
          {
            "$id": "Available",
            "backgroundColor": {
              "solid": {
                "color": "#ffffff"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "#000000"
              }
            },
            "transparency": 0
          }
        ]
      }
    }
  }
}